{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "proseWrap": "never",
  "singleQuote": false,
  "trailingComma": "none",
  "semi": true,
  "tabWidth": 2,
  "useTabs": false,
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "**/dist/**",
    "**/types/**",
    "**/libs/**",
    "**/fixtures/**",
    "**/*.gs",
    "**/*.glsl",
    "**/*.md",
    "**/*.mdx",
    "**/downloads/**",
    "**/test-results/**",
    "e2e/.dev/**",
    "playwright-report/**"
  ]
}
