{
  "name": "@galacean/engine-root",
  "version": "1.6.13",
  "private": true,
  "repository": "git@github.com:galacean/runtime.git",
  "scripts": {
    "test": "vitest",
    "coverage": "vitest --coverage --browser.headless",
    "browsers:install": "playwright install --with-deps chromium",
    "examples": "pnpm --filter @galacean/engine-examples dev",
    "build": "pnpm b:esm && pnpm b:types && pnpm b:examples",
    "lint": "oxlint --quiet packages/*/src",
    "lint:fix": "oxlint --fix --quiet packages/*/src",
    "lint:type-aware": "oxlint --type-aware --quiet packages/*/src",
    "format": "oxfmt packages tests examples e2e scripts .github package.json pnpm-workspace.yaml tsconfig.tests.json rolldown.config.mjs rolldown-plugin-glsl.mjs vitest.config.ts .oxfmtrc.jsonc .oxlintrc.json",
    "format:check": "oxfmt --check packages tests examples e2e scripts .github package.json pnpm-workspace.yaml tsconfig.tests.json rolldown.config.mjs rolldown-plugin-glsl.mjs vitest.config.ts .oxfmtrc.jsonc .oxlintrc.json",
    "watch": "rolldown -cw -m inline --config rolldown.config.mjs",
    "dev": "pnpm examples",
    "b:types": "pnpm -r --filter=./packages/* run b:types && pnpm -C e2e run b:types",
    "b:esm": "rolldown --config rolldown.config.mjs",
    "b:examples": "pnpm -C examples run build",
    "b:all": "pnpm b:types && pnpm b:esm",
    "clean": "pnpm -r exec rm -rf dist && pnpm -r exec rm -rf types",
    "e2e:case": "pnpm -C ./e2e run case",
    "e2e": "playwright test",
    "e2e:debug": "playwright test --ui",
    "prepare": "husky",
    "release": "bumpp -r"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@playwright/test": "1.61.1",
    "@types/node": "22.20.1",
    "@types/webxr": "0.5.24",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "bumpp": "11.1.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "odiff-bin": "4.3.8",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "oxlint-tsgolint": "0.25.0",
    "playwright": "1.61.1",
    "rolldown": "1.2.0",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@11.15.0"
}
