{
  "compilerOptions": {
    "target": "ES2017",
    "module": "preserve",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "strict": false,
    "lib": ["ES2017", "DOM"],
    "declaration": true,
    "inlineSourceMap": true,
    "outDir": "lib",
    "rootDir": "src"
  },
  "include": ["src/*.ts"]
}
